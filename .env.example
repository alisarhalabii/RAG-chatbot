# Copy this file to .env and fill in your own values. Never commit the real .env file.

# "groq" = cloud LLM (used for the deployed/live version, no local model needed)
# "ollama" = local LLM (for offline development, requires Ollama running with the model pulled)
LLM_PROVIDER=groq

# Free API key from https://console.groq.com (only needed when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Only used when LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Comma-separated list of origins allowed to call this API from the browser.
# Add your deployed Vercel URL here once you have it, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
